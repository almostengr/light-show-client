@using Almostengr.Common.Common.Shared
@using Almostengr.LightShow.Connect.Services.AppSettingsManager
@model AppSettingsResource

<h1>Configuration</h1>
<div class="mt-3">
    <div class="mb-3">
        <div class="form-label">Player URL</div>
        <div>@Model.PlayerUrl</div>
    </div>
    <div class="mb-3">
        <div class="form-label">Player Type</div>
        <div>@Model.TypeOption.ToDescription()</div>
    </div>
    <div class="mb-3">
        <div class="form-label">Website URL</div>
        <div>@Model.WebsiteUrl</div>
    </div>
    <div class="mb-3">
        <div class="form-label">Website API Key</div>
        <div>
            @if (string.IsNullOrWhiteSpace(Model.WebsiteApiKey))
            {
                <span>Not entered</span>
            }
            else
            {
                <span>Entered</span>
            }
        </div>
    </div>
    <div class="mb-3">
        <div class="form-label">Sleep Interval</div>
        <div>@Model.WorkerSleepInterval</div>
    </div>
    <div class="mb-3">
        <a href="#" class="btn btn-primary modalLink" data-url="/appsetting/edit">Edit</a>
    </div>
</div>