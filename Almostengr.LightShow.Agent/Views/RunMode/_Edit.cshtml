@using Almostengr.LightShow.Common
@model RunModeViewModel

<div class="modal-header">
    <h5 class="modal-title">Manage Run Mode</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form action="/runmode/edit" method="post">
        <div class="mb-3">
            <label for="PlayerUrl" class="form-label required">Run Mode</label>
            <select class="form-select" asp-for="@Model.ModeOption"
                    asp-items="@Html.GetEnumSelectList<DisplayModeOption>()">
            </select>
        </div>
    </form>
</div>
<partial name="_ModalFooter" />
